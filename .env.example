# promo-infrastructure/.env.example
# Copy this file to a new file named '.env' and fill in your actual password before starting docker
ELASTIC_PASSWORD=placeholder_set_your_own_secure_password
# Kibana encryption keys, at least 32 characters each. Generate with: openssl rand -hex 32
KIBANA_SECURITY_ENCRYPTION_KEY=placeholder_generate_with_openssl_rand_hex_32
KIBANA_SAVED_OBJECTS_ENCRYPTION_KEY=placeholder_generate_with_openssl_rand_hex_32
KIBANA_REPORTING_ENCRYPTION_KEY=placeholder_generate_with_openssl_rand_hex_32
POSTGRES_PASSWORD=placeholder_set_your_own_secure_password
REDIS_PASSWORD=placeholder_set_your_own_secure_password
